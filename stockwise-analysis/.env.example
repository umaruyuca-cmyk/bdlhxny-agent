# StockWise Analysis 环境变量示例
# 复制为 .env 并填入真实值。生产环境由部署系统统一注入，不要提交真实密钥。

# ── 基础运行 ──
STOCKWISE_ENV=development
# Checkpointer 后端：memory（开发）/ postgres / redis（生产必用持久化）
STOCKWISE_CHECKPOINTER_BACKEND=memory
STOCKWISE_API_PREFIX=/api/v1
STOCKWISE_MAX_EVENT_WAIT_SECONDS=30

# 生产 Checkpointer 连接串（backend=postgres/redis 时必填）
# POSTGRES_DSN=postgresql://user:pass@host:5432/dbname
# REDIS_URL=redis://host:6379/0

# ── MCP 数据源（两个服务传输协议不同，必须分别配置）──
# akshare-one：Streamable HTTP
AKSHARE_ONE_MCP_TRANSPORT=streamable_http
AKSHARE_ONE_MCP_ENDPOINT=http://118.25.178.86:8083/mcp
AKSHARE_ONE_MCP_TIMEOUT=20
# AKSHARE_ONE_MCP_TOKEN=

# cn-financial：SSE
CN_FINANCIAL_MCP_TRANSPORT=sse
CN_FINANCIAL_MCP_ENDPOINT=http://118.25.178.86:8000/sse
CN_FINANCIAL_MCP_TIMEOUT=20
# CN_FINANCIAL_MCP_TOKEN=

# ── 记忆层（Mem0 内部 LLM 与 Embedding，显式指定避免走默认 OpenAI）──
MEM0_LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MEM0_EMBEDDER_MODEL=Qwen3-Embedding
QWEN3_API_KEY=
# QWEN3_BASE_URL=

# ── Java 用户数据服务（持仓/账户/风控画像，Phase 4）──
# 未配置时开发环境 mock 降级；生产环境未配置返回 UNAVAILABLE，不伪造持仓
# JAVA_API_BASE_URL=http://localhost:8080
# JAVA_API_TOKEN=
