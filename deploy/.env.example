# 仅用于本地私有运行依赖。复制为 deploy/.env 后修改，deploy/.env 不进入 Git。

POSTGRES_DB=touchstone
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-this-postgres-password

TOUCHSTONE_DATA_DB_USER=bdlh_runtime_data
TOUCHSTONE_DATA_DB_PASSWORD=change-this-data-password
TOUCHSTONE_MEMORY_DB_USER=bdlh_memory_service
TOUCHSTONE_MEMORY_DB_PASSWORD=change-this-memory-password

JWT_SECRET=change-this-jwt-secret-at-least-32-characters
JAVA_DATA_INTERNAL_TOKEN=change-this-data-internal-token
MEMORY_SERVICE_INTERNAL_TOKEN=change-this-memory-internal-token

BDLH_RUNTIME_SINGLE_USER_ID=1
ROCKETMQ_ENABLED=true
MEMORY_ROCKETMQ_ENABLED=true

# 接入真实语义记忆时填写。留空时服务可启动，但记忆网关会降级为不可用。
MEM0_CONFIG_JSON=
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7
QWEN3_API_KEY=
QWEN3_BASE_URL=
MEM0_EMBEDDER_MODEL=Qwen3-Embedding
