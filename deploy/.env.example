POSTGRES_DB=touchstone
POSTGRES_USER=touchstone
POSTGRES_PASSWORD=replace-with-a-strong-database-password

DATA_INTERNAL_TOKEN=replace-with-a-random-internal-token

LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7-flash
GIT_COMMIT=local
MAX_CONCURRENT_BATCHES=1
# /lab 页面跨端口调用运行 API 的来源（私有部署按 CONSOLE 绑定填写；留空=禁用 CORS，公开部署留空）
RUN_API_ALLOWED_ORIGINS=

ENGINE_PORT=8090
CONSOLE_BIND=127.0.0.1
CONSOLE_PORT=8082
